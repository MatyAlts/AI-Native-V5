# Runner: UNICO componente con acceso al socket de Docker (ADR-060, gate D3).
#
# Se despliega con `/var/run/docker.sock` montado. El `execution-service` NO
# lleva el socket: le habla a este por HTTP.
#
#   docker run -v /var/run/docker.sock:/var/run/docker.sock \
#              -e RUNNER_TOKEN=<secreto> ...
#
# El runner NO debe ser alcanzable desde fuera de la red interna: su unico
# cliente legitimo es el execution-service.

FROM python:3.12-slim AS builder

ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
RUN --mount=from=ghcr.io/astral-sh/uv:latest,source=/uv,target=/bin/uv \
    --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --no-install-project --no-dev

COPY . /app
WORKDIR /app
RUN --mount=from=ghcr.io/astral-sh/uv:latest,source=/uv,target=/bin/uv \
    --mount=type=cache,target=/root/.cache/uv \
    uv sync --all-packages --no-dev

FROM python:3.12-slim

# El cliente de Docker: el runner invoca `docker run`, no habla el protocolo.
#
# Es `docker-cli`, NO `docker.io`. En Debian trixie (la base de python:3.12-slim)
# el paquete esta partido: `docker.io` trae el DAEMON y `docker-cli` el comando
# `docker`. Con `--no-install-recommends` el cliente no viene de arrastre, asi
# que `docker.io` instala bien, loguea `Setting up docker.io 26.1.5`, y deja la
# imagen sin `/usr/bin/docker`. El runner arranca igual y contesta 401 como
# corresponde —el warmup es best-effort— pero no puede ejecutar una sola
# corrida. Costo un dia de diagnostico el 2026-08-03: el build en verde y el log
# del apt decian que estaba, y el binario no estaba.
#
# Ademas el daemon aca sobra y es superficie de mas: este es el unico contenedor
# con el socket montado (ADR-060 D3), y el daemon real vive en el host.
RUN apt-get update && apt-get install -y --no-install-recommends docker-cli \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app /app
WORKDIR /app

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

ENTRYPOINT ["/app/.venv/bin/python", "-m", "uvicorn", "execution_service.runner_main:app", "--host", "0.0.0.0", "--port", "8015"]
