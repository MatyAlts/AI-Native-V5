Algoritmo cadenas
	Definir s Como Caracter
	s <- "Programacion"
	Escribir Longitud(s)
	Escribir Subcadena(s, 1, 3)
	Escribir Subcadena(s, 4, 7)
	Escribir Mayusculas(s)
	Escribir Minusculas("HOLA")
	Escribir Concatenar("uno", "dos")
	Escribir ConvertirANumero("12") + 1
	Escribir ConvertirATexto(5) + "0"
	Escribir "abc" < "abd"
	Escribir "Ana" = "Ana"
FinAlgoritmo
