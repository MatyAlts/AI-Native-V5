Algoritmo paridad
	Definir n Como Entero
	Leer n
	Si n MOD 2 = 0 Entonces
		Escribir n, " es par"
	SiNo
		Escribir n, " es impar"
	FinSi
	Si n > 10 Y n < 100 Entonces
		Escribir "dos cifras"
	FinSi
	Si n < 0 O n = 0 Entonces
		Escribir "no positivo"
	FinSi
	Si NO (n = 5) Entonces
		Escribir "no es cinco"
	FinSi
FinAlgoritmo
