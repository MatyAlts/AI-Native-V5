{
  "name": "@platform/pseint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/run.js",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@platform/contracts": "workspace:*",
    "@types/node": "^22.0.0",
    "esbuild": "0.25.12",
    "typescript": "~5.6.0",
    "vitest": "^2.1.0"
  }
}
