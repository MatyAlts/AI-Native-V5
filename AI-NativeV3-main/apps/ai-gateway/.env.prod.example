LOG_LEVEL=info
LOG_FORMAT=json
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME_PREFIX=platform
BYOK_MASTER_KEY=CHANGE_ME_32_BYTES_BASE64
ACADEMIC_DB_URL=postgresql+asyncpg://academic_user:CHANGE_ME_ACADEMIC_DB_PASSWORD@postgres:5432/academic_main
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
# OpenRouter (motor principal global, API OpenAI-compatible). Si queda vacia,
# el ruteo namespaced (openai/gpt-4o-mini, google/gemini-2.5-flash) cae de forma
# segura al provider nativo (seguridad keyless) — el deploy sin esta key es no-op.
OPENROUTER_API_KEY=
# Atribucion recomendada por OpenRouter (headers HTTP-Referer / X-Title).
OPENROUTER_REFERER=https://active-ia.com
OPENROUTER_TITLE=AI-Native
